@startuml 21-seq-submit-optimistic
!include ../../_style.iuml
title Nós no Cabo v1 — Submit with an optimistic draft (ADR 0003)

actor Submitter
participant "SubmitWebsite page" as page
participant "useWebsitePreview" as preview
participant "useSubmitWebsite" as submit
participant "pendingSubmissions\n(localStorage)" as store
participant "Feed" as feed
participant "usePendingStatusPolling" as poll
participant "API /v1" as api

Submitter -> page : paste URL
page -> preview : url (debounced 400 ms, normalized)
preview -> api : GET /websites/preview?url=
alt duplicate
  api --> preview : 409 {existingId}
  page --> Submitter : "Esse site já está no Nós no Cabo" + link
else ok
  api --> preview : WebsitePreview
  page --> Submitter : preview card + prefilled name,\ndescription, color
end
Submitter -> page : adjust fields, pick 1–3 categories
Submitter -> page : Turnstile + "Enviar"
page -> submit : mutate(submission)
submit -> api : POST /websites
api --> submit : 202 Website {id, status: checking}
submit -> store : add draft {id, …, status: checking, submittedAt}
page --> Submitter : toast + navigate to /websites
opt bell on a draft card (only while permission is undecided)
  feed -> Submitter : Notification.requestPermission() (once, for all sites)
  feed -> api : POST /websites/:id/subscriptions\n(see backend/17-seq-web-push)
end

== Later, including after a page refresh ==
Submitter -> feed : /websites
feed -> store : drafts
feed --> Submitter : drafts first (dashed border + "Em análise")
poll -> api : GET /websites/status?ids=… (one request for all drafts;\nevery 15 s for 2 min while visible, then on load/focus)
alt published
  api --> poll : status published
  poll -> store : drop draft
  poll -> feed : invalidate ['websites']
  feed --> Submitter : the card now comes from the server list
  opt notification permission granted and a tab is open
    poll -> Submitter : local Notification "{name} foi publicado"
  end
else rejected
  api --> poll : status rejected, reason
  poll -> store : mark rejected
  feed --> Submitter : rejected card with reason + "Dispensar"
else nobody has the site open
  note over poll, api : nothing polls; Web Push reaches the submitter,\nand the next visit checks once
else still checking after 7 days
  poll -> store : expire draft
end

@enduml
