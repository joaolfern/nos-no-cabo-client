@startuml 11-data-model
!include ../../_style.iuml
hide circle
skinparam linetype ortho
title Nós no Cabo v1 — Data model (D1 / SQLite)

package "catalog D1 (migrations 0001–0011)" {
  entity "websites" as websites {
    * id : text <<PK, ULID>>
    --
    * url : text (as submitted)
    * url_normalized : text <<unique>>
    * name : text
    description : text
    color : text
    favicon_url : text
    repo : text
    short_code : text <<unique>> (set on publish)
    * status : text  checking | published | rejected
    rejection_reason : text  unsafe | unreachable | error
    review_flag : text  model_error | unreachable | reported
    category_slugs : text (json, derived)
    ring_group : integer (generated: verified_at IS NULL)
    * submitted_at : integer (epoch ms)
    published_at : integer
    verified_at : integer (null = unverified)
    last_verification_check_at : integer
    verification_misses : integer
    rank_score : real (from metrics, every 3 h)
    likes : integer (net up − down votes, from metrics)
    * submitter_ip_hash : text (salted)
  }

  entity "categories" as categories {
    * slug : text <<PK>>
    --
    * position : integer
    published_count : integer (derived)
  }

  entity "website_categories" as wc {
    * website_id : text <<PK, FK>>
    * category_slug : text <<PK, FK>>
  }

  entity "websites_fts" as fts {
    website_id (unindexed)
    name
    description
    FTS5, unicode61 remove_diacritics 2
  }

  entity "counters" as counters {
    * name : text <<PK>>
    --
    * value : integer
    published_websites | ring_version |
    <quota>:<UTC day> (daily AI budget)
  }

  entity "moderation_results" as moderation {
    * id : integer <<PK>>
    --
    * website_id : text <<FK>>
    * verdict : text  safe | unsafe | error
    categories_flagged : text (json)
    * model : text
    * checked_at : integer
  }

  entity "moderation_backlog" as backlog {
    * website_id : text <<PK, FK>>
    --
    * deferred_at : integer
    waits for the next day's AI budget
  }

  entity "reports" as reports {
    * id : integer <<PK>>
    --
    * website_id : text <<FK>>
    * reason : text  inappropriate | spam | broken |\nimpersonation | other
    comment : text
    * reporter_ip_hash : text (salted)
    * created_at : integer
    <<unique>> (website_id, reporter_ip_hash)
  }

  entity "push_subscriptions" as subs {
    * website_id : text <<PK, FK>>
    * endpoint : text <<PK>>
    --
    * p256dh : text
    * auth : text
    * created_at : integer
    ≤ 5 per site, only while checking,
    deleted once sent or after 7 days
  }
}

package "metrics D1 (ADR 0006)" {
  entity "visits" as visits {
    * website_id : text <<PK>>
    * day : text <<PK>>
    * visitor_hash : text <<PK>>
    * kind : text <<PK>>  click | referral
    --
    dedupe only; old days deleted by the cron
  }
  entity "daily_stats" as daily {
    * website_id : text <<PK>>
    * day : text <<PK>>
    --
    clicks : integer
    referrals : integer
  }
  entity "site_totals" as totals {
    * website_id : text <<PK>>
    --
    clicks : integer
    referrals : integer
    likes : integer
    dislikes : integer
  }
  entity "votes" as votes {
    * website_id : text <<PK>>
    * voter_hash : text <<PK>>
    --
    * value : integer  1 | -1
    * updated_at : integer
  }
}

websites ||--o{ wc
categories ||--o{ wc
websites ||--o{ moderation
websites ||--o| backlog
websites ||--o{ reports
websites ||--o{ subs
websites ||--|| fts : kept by triggers
websites .. totals : by id (cross-service,\nno FK)
visits .. daily : triggers
visits .. totals : triggers
votes .. totals : triggers

note right of counters
  Derived values (ADR 0005) are kept by triggers and
  recomputed by sql/rebuild-derived.sql. The ring order is
  read from the websites_by_ring index; the router caches
  it and refetches when ring_version changes.
end note

note right of websites
  • url_normalized (lowercase host, no scheme, www, query,
    trailing slash) is the dedupe key → 409 with the existing id.
    A rejected row is replaced when the URL is submitted again.
  • Timestamps are integers (epoch ms); the API returns ISO.
  • Ids are ULIDs, generated by the server.
  • Raw IPs are never stored, only salted hashes.
end note

@enduml
