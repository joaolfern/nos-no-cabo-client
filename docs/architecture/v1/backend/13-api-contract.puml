@startuml 13-api-contract
!include ../../_style.iuml
hide circle
hide empty members
title Nós no Cabo v1 — Public HTTP API (@nosnocabo/contract 0.5.0)

package "catalog" {
  class "GET /v1/websites/preview?url=" as preview {
    {field} → WebsitePreview (scraped, not stored)
    {field} 409 duplicate {existingId} · 422 invalid | unreachable
  }
  class "POST /v1/websites" as create {
    {field} header cf-turnstile-response · body WebsiteSubmission
    {field} → 202 Website (status: checking)
    {field} 409 duplicate · 422 invalid · 400 turnstile_failed
  }
  class "GET /v1/websites" as list {
    {field} ?categoria= &q= &sort=melhores|recentes|curtidos|az
    {field} &cursor= &limit= (24, max 48)
    {field} → Page<Website>, published only, sorted server-side
  }
  class "GET /v1/websites/:id" as get {
    {field} → Website · 404
  }
  class "GET /v1/websites/status?ids=" as status {
    {field} → WebsiteStatusEntry[] (one request for every draft)
  }
  class "GET /v1/websites/:id/neighbours" as neighbours {
    {field} → WebsiteNeighbours {previous, next, random}
  }
  class "POST /v1/websites/:id/reports" as report {
    {field} header cf-turnstile-response · body ReportSubmission
    {field} → 202 · 404 unless published
  }
  class "POST /v1/websites/:id/subscriptions" as subscribe {
    {field} body PushSubscriptionSubmission
    {field} → 204 · 404 unless checking (≤ 5 per site)
  }
  class "GET /v1/categories" as categories {
    {field} → CategoryList {total, items: {slug, count}[]}
  }
}

package "gateway" {
  class "GET /v1/websites/:id/page" as page {
    {field} → WebsitePage {website, neighbours, stats | null}
    {field} one request per website page
  }
}

package "verification" {
  class "POST /v1/websites/:id/verify" as verify {
    {field} → VerificationResult {verified, verifiedAt, reason?}
    {field} 429 rate_limited (1 check per site per minute) · 404
  }
}

package "metrics" {
  class "GET /v1/websites/:id/stats" as stats {
    {field} → WebsiteStats
  }
  class "POST /v1/websites/:id/votes" as votes {
    {field} header cf-turnstile-response · body VoteSubmission
    {field} → WebsiteStats · 404 unless published
  }
}

package "router (not under /v1)" {
  class "GET /r/:code" as short {
    {field} 302 → website.url (click recorded after the redirect)
  }
  class "GET /ring/:id/next | prev | random" as ring {
    {field} 302 → neighbour url; click on the target, referral on :id
    {field} unknown id / empty ring → HOME_URL
  }
}

package "schemas" {
  class WebsiteSubmission {
    {field} url · name (3..80) · description (≤ 280)
    {field} color? (#rrggbb) · faviconUrl? · repo?
    {field} categories : slug[] (1..3, 11 slugs)
  }
  class Website {
    {field} id (ULID) · url · shortCode | null
    {field} name · description · color · faviconUrl · repo?
    {field} categories : slug[]
    {field} status : checking | published | rejected
    {field} rejectionReason? : unsafe | unreachable | error
    {field} verifiedAt · submittedAt · publishedAt (ISO)
    {field} likes : integer (net up − down votes)
  }
  class WebsiteStats {
    {field} clicks · clicks30d · referrals · likes · dislikes
  }
  class VoteSubmission {
    {field} voterId : uuid · value : 1 | -1 | 0
  }
  class ReportSubmission {
    {field} reason : inappropriate | spam | broken |
    {field}   impersonation | other
    {field} comment? (≤ 500)
  }
  class "Page<T>" as pageOf {
    {field} items : T[] · nextCursor : string | null · total
  }
  class "Error envelope" as error {
    {field} {error: {code, message, existingId?}}
    {field} code: duplicate | invalid | unreachable | rate_limited |
    {field}   turnstile_failed | not_found | internal
    {field} message in pt-BR, safe to show
  }
}

preview -[hidden]down- get
create -[hidden]down- status
list -[hidden]down- neighbours
get -[hidden]down- report
status -[hidden]down- subscribe
neighbours -[hidden]down- categories
report -[hidden]down- page
subscribe -[hidden]down- verify
categories -[hidden]down- stats
page -[hidden]down- short
verify -[hidden]down- ring
stats -[hidden]down- votes
short -[hidden]down- WebsiteSubmission
ring -[hidden]down- Website
votes -[hidden]down- error

create ..> WebsiteSubmission
create ..> Website
get ..> Website
list ..> pageOf
pageOf ..> Website
page ..> Website
page ..> WebsiteStats
stats ..> WebsiteStats
votes ..> VoteSubmission
report ..> ReportSubmission

note as conventions
  <b>Conventions</b>
  • Routes are versioned under /v1, except the redirects /r and /ring
  • Ids are strings; timestamps are ISO-8601 in responses
  • One error envelope; the client reads error.code, never parses message
  • Every write a visitor makes passes Turnstile; no per-IP limits
  • CORS: GET, POST from ALLOWED_ORIGINS and *.nosnocabo.pages.dev
end note

@enduml
