' Shared look for every diagram.

skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam packageStyle rectangle
skinparam linetype ortho

skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #C9B458
}

skinparam component<<external>> {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam rectangle<<external>> {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam participant<<external>> {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}

' Code in the private moderation repo: drawn as a black box.
skinparam component<<private>> {
  BackgroundColor #EEEEEE
  BorderColor #616161
  BorderStyle dashed
}
skinparam participant<<private>> {
  BackgroundColor #EEEEEE
  BorderColor #616161
}

skinparam component<<cron>> {
  BackgroundColor #FFF3E0
  BorderColor #EF6C00
}
skinparam participant<<cron>> {
  BackgroundColor #FFF3E0
  BorderColor #EF6C00
}
