@startuml 15-seq-verification
!include ../../_style.iuml
title Widget verification (target)

actor "Site owner" as owner
participant "SPA\n/website/:id" as spa
participant "gateway" as gw
participant "verification" as ver
participant "Member site" as site
participant "catalog" as catalog
participant "Cron Trigger\n(daily)" as cron

== On request ==
owner -> site : paste widget snippet\n(from /websites/:id/selo)
owner -> spa : "Verificar"
spa -> gw : POST /v1/websites/:id/verify
gw -> ver : verify(id) (1/min per site)
ver -> catalog : get(id) (internal)
ver -> site : GET website.url
ver -> ver : detect <aside data-nnc-widget="<id>">\ncontaining a link to NOS_NO_CABO_URL or /ring/<id>/
alt widget found
  ver -> catalog : setVerified(id, now)
  ver --> spa : {verified: true, verifiedAt}
else not found
  ver --> spa : {verified: false, reason: widget_not_found}
end

== Periodic recheck ==
cron -> ver : scheduled()
ver -> catalog : verified sites, oldest\nlast_verification_check_at first (batch of 50)
loop each site
  ver -> site : GET url
  alt widget present
    ver -> catalog : touch last_verification_check_at
  else missing twice in a row
    ver -> catalog : setVerified(id, null)
  end
end

note right of ver
  The data-nnc-widget attribute carries the website id,
  so a copied snippet cannot verify a different site.
  Checking server-side (instead of the widget pinging
  the API) means the result cannot be faked from a browser.
end note

@enduml
