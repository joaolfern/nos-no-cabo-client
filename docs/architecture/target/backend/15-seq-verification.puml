@startuml 15-seq-verification
!include ../../_style.iuml
title Widget verification (target)

actor "Site owner" as owner
participant "SPA\n/website/:id" as spa
participant "gateway" as gw
participant "verification" as ver
participant "Member site" as site
participant "catalog" as catalog
participant "Cron Trigger\n(hourly)" as cron

== On request ==
owner -> site : paste widget snippet\n(from /websites/:id/selo)
owner -> spa : "Verificar"
spa -> gw : POST /v1/websites/:id/verify
gw -> ver : POST /v1/websites/:id/verify\n(VERIFICATION service binding)
ver -> catalog : getVerificationTarget(id)
ver -> catalog : claimVerificationCheck(id)\n(atomic, 1 per site per minute; else 429)
ver -> site : GET website.url
ver -> ver : detect <aside data-nnc-widget="<id>">\ncontaining a link to NOS_NO_CABO_URL or /ring/<id>/
alt widget found
  ver -> catalog : recordVerification(id, found, manual)
  ver --> spa : {verified: true, verifiedAt}
else not found / unreachable
  ver --> spa : {verified: false, reason}\n(badge unchanged: a manual check only grants)
end

== Periodic recheck ==
cron -> ver : scheduled()
ver -> catalog : dueForRecheck(20): verified sites not\nchecked in 20 h, oldest first
loop each site
  ver -> site : GET url
  ver -> catalog : recordVerification(id, found, recheck)
  note right: found: misses = 0\nmissed: misses + 1; at 2, verified_at = NULL
end

note right of ver
  The data-nnc-widget attribute carries the website id,
  so a copied snippet cannot verify a different site.
  Checking server-side (instead of the widget pinging
  the API) means the result cannot be faked from a browser.
end note

@enduml
