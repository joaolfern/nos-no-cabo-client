@startuml 11-data-model
!include ../../_style.iuml
hide circle
skinparam linetype ortho
title Data model (target, D1 / SQLite)

package "catalog D1" {
  entity "websites" as websites <<new>> {
    * id : text <<PK, ULID>>
    --
    * url : text (as submitted)
    * url_normalized : text <<unique>>
    * name : text
    description : text
    color : text
    favicon_url : text
    repo : text
    short_code : text <<unique>> (set on publish)
    * status : text  checking | published | rejected
    rejection_reason : text  unsafe | unreachable | error
    category_slugs : text (json, derived)
    ring_group : integer (generated: verified_at IS NULL)
    review_flag : text  model_error | unreachable | reported\n(null = no manual review needed)
    * submitted_at : integer (epoch ms)
    published_at : integer
    verified_at : integer (null = unverified)
    last_verification_check_at : integer
    rank_score : real (hourly, from metrics; ADR 0004)
    * submitter_ip_hash : text
  }

  entity "categories" as categories <<new>> {
    * slug : text <<PK>>
    --
    * position : integer
    published_count : integer (derived)
  }

  entity "counters" as counters <<new>> {
    * name : text <<PK>>  published_websites | ring_version
    --
    * value : integer
  }

  entity "websites_fts" as fts <<new>> {
    website_id (unindexed)
    name
    description
    FTS5, unicode61 remove_diacritics 2
  }

  entity "website_categories" as wc <<new>> {
    * website_id : text <<PK, FK>>
    * category_slug : text <<PK, FK>>
  }

  entity "moderation_results" as moderation <<new>> {
    * id : integer <<PK>>
    --
    * website_id : text <<FK>>
    * verdict : text  safe | unsafe | error
    categories_flagged : text (json)
    * model : text
    * checked_at : integer
  }

  entity "reports" as reports <<new>> {
    * id : integer <<PK>>
    --
    * website_id : text <<FK>>
    * reason : text  inappropriate | spam | broken |\nimpersonation | other
    comment : text
    * reporter_ip_hash : text
    * created_at : integer
    <<unique>> (website_id, reporter_ip_hash)
  }
}

package "router KV" {
  entity "short:{code}" as short <<new>> {
    website_id
  }
}

package "metrics D1" {
  entity "events" as events <<new>> {
    * id : integer <<PK>>
    --
    * website_id : text
    * type : text  view | click | like
    * at : integer
    visitor_hash : text
  }
  entity "daily_stats" as daily <<new>> {
    * website_id : text <<PK>>
    * day : text <<PK>>
    --
    views : integer
    clicks : integer
    likes : integer
  }
}

websites ||--o{ wc
categories ||--o{ wc
websites ||--o{ moderation
websites ||--o{ reports
websites ||--|| fts : kept by triggers
websites .. short : by id (cross-service,\nno FK)
websites .. events : by id (cross-service,\nno FK)
events .. daily : rolled up by cron

note right of counters
  Derived values (ADR 0005) are kept by triggers and
  recomputed by sql/rebuild-derived.sql. The ring order is
  read from the websites_by_ring index; the router caches
  it and refetches when ring_version changes.
end note

note right of websites
  • url_normalized (lowercase host, no scheme/www/trailing slash)
    is the dedupe key → 409 with the existing id.
  • Timestamps are integers (epoch ms), not strings.
  • Ids are ULIDs (sortable by creation, not guessable like
    sequential ints). The server generates them; the 202 response
    returns the id the client's draft tracks.
  • submitter_ip_hash supports rate limits and abuse review
    without storing raw IPs.
end note

@enduml
