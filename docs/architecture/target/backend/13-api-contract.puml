@startuml 13-api-contract
!include ../../_style.iuml
hide circle
hide empty members
title Public HTTP API /v1 (target)

package "catalog" {
  class "GET /v1/websites/preview?url=" as preview <<new>> {
    {field} → WebsitePreview (scraped, not stored)
    {field} 409 duplicate {error, existingId}
    {field} 422 unreachable / invalid url
  }
  class "POST /v1/websites" as create <<new>> {
    {field} body WebsiteSubmission
    {field} header cf-turnstile-response
    {field} → 202 Website (status: checking)
    {field} 409 duplicate {error, existingId}
    {field} 429 rate limited
  }
  class "GET /v1/websites/:id" as get <<new>> {
    {field} → Website
    {field} checking/rejected: only the fields a draft needs
    {field} 404
  }
  class "GET /v1/websites/status?ids=" as status <<new>> {
    {field} → {id, status, rejectionReason?}[]
    {field} one request for all of a submitter's drafts
  }
  class "GET /v1/websites" as list <<new>> {
    {field} ?categoria=slug &q= &sort=melhores|recentes|curtidos|az
    {field} &cursor= &limit=24
    {field} → Page<Website> (published only, sorted server-side;
    {field}   melhores = rank_score, see ADR 0004)
  }
  class "GET /v1/categories" as categories <<new>> {
    {field} → {slug, count}[]
  }
}

package "verification" {
  class "POST /v1/websites/:id/verify" as verify <<new>> {
    {field} → {verified, verifiedAt, reason?}
    {field} 429 (1 request per site per minute)
  }
}

package "router" {
  class "GET /r/:code" as short <<new>> {
    {field} 302 → website.url (+ click, recorded after the redirect)
  }
  class "GET /ring/:id/next | prev | random" as ring <<new>> {
    {field} 302 → neighbour website.url
    {field} used by the widget links
    {field} + click on the target, referral on :id
  }
}

package "metrics" {
  class "GET /v1/websites/:id/page" as page <<new>> {
    {field} → WebsitePage {website, neighbours, stats | null}
    {field} composed by the gateway: one public request per website page
  }
  class "GET /v1/websites/:id/stats" as stats <<new>> {
    {field} → WebsiteStats {clicks, clicks30d, referrals, likes, dislikes}
  }
  class "POST /v1/websites/:id/votes" as votes <<new>> {
    {field} header cf-turnstile-response
    {field} body {voterId: uuid, value: 1 | -1 | 0}
    {field} → WebsiteStats; 404 unless published
  }
}

package "schemas" {
  class WebsitePreview <<new>> {
    {field} url : string
    {field} name : string | null
    {field} description : string | null
    {field} color : string | null
    {field} faviconUrl : string | null
  }
  class WebsiteSubmission <<new>> {
    {field} url : string
    {field} name : string (3..80)
    {field} description : string (≤ 280)
    {field} color? : string (#rrggbb)
    {field} faviconUrl? : string
    {field} repo? : string
    {field} categories : slug[] (1..3)
  }
  class Website <<new>> {
    {field} id : string (ULID)
    {field} url : string (real URL)
    {field} shortCode : string | null (set on publish)
    {field} name, description, color, faviconUrl, repo?
    {field} categories : slug[]
    {field} status : checking | published | rejected
    {field} rejectionReason? : unsafe | unreachable | error
    {field} verifiedAt : string | null (ISO)
    {field} submittedAt, publishedAt : string (ISO)
    {field} likes : integer (net 👍 − 👎)
  }
  class "Page<T>" as page <<new>> {
    {field} items : T[]
    {field} nextCursor : string | null
    {field} total : number
  }
  class "Error envelope" as error <<new>> {
    {field} {error: {code, message, details?}}
    {field} code: duplicate | invalid | rate_limited |
    {field}   turnstile_failed | not_found | internal
    {field} message in pt-BR, safe to show
  }
}

preview ..> WebsitePreview
create ..> WebsiteSubmission
create ..> Website
get ..> Website
list ..> page
page ..> Website

note as conventions
  <b>Conventions</b>
  • Every route is versioned under /v1 (except the redirects /r and /ring)
  • Plural resources; ids are strings
  • Timestamps are ISO-8601 in responses
  • One error envelope; the client reads error.code, never parses message
  • No admin password in the client; moderation tooling goes behind
    Cloudflare Access (out of scope here)
end note

@enduml
