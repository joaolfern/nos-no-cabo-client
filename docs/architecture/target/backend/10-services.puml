@startuml 10-services
!include ../../_style.iuml
skinparam linetype polyline
title Backend services and data ownership (target)

component "gateway\nroutes /v1/*, CORS (no per-IP limits),\nerror envelope {error:{code,message}}" as gw <<new>>

package "catalog (owns catalog D1)" {
  component "websites\nlist · get · create · preview" as websites <<new>>
  component "categories\n(11 slugs, docs/categories.md)" as categories <<new>>
  component "scraper\nHTMLRewriter: title, description,\nfavicon, theme color" as scraper <<new>>
  component "CatalogRpc\ngetForModeration · applyModeration\ngetRing · getRingVersion\ngetVerificationTarget · claimVerificationCheck\nrecordVerification · dueForRecheck\ngetRankInputs · setMetrics · isPublished" as internal <<new>>
}

package "moderation" {
  component "queue consumer\nmoderation-jobs" as consumer <<new>>
  component "SFW classifier\nWorkers AI llama-guard (text)\n+ optional image check" as classifier <<new>>
}

package "verification" {
  component "verify on request\nPOST /websites/:id/verify\n(1 check per site per minute)" as verifyNow <<new>>
  component "cron recheck\nhourly, 20 sites per run;\n2 misses in a row remove the badge" as cron <<new>>
  component "widget detector\ndata-nnc-widget marker\n+ link to webring" as detector <<new>>
}

package "router (public; ring snapshot in memory)" {
  component "short links\nGET /r/:code → 302" as short <<new>>
  component "webring navigation\n/ring/:id/next|prev|random" as ring <<new>>
}

package "metrics (owns metrics D1; ADR 0006)" {
  component "MetricsRpc.recordClick\ncookieless visitor hash,\none per site per day" as events <<new>>
  component "stats · votes\nGET /websites/:id/stats\nPOST /websites/:id/votes (Turnstile)" as stats <<new>>
  component "cron every 3 hours\nrank_score + net likes\n(changed values only)" as rollups <<new>>
}

queue "moderation-jobs" as q <<new>>

gw --> websites
gw --> categories
gw --> verifyNow
gw --> stats

websites --> scraper
websites --> q : enqueue on create
q --> consumer
consumer --> scraper : fetch content
consumer --> classifier
consumer --> internal : published / rejected

verifyNow --> detector
cron --> detector
verifyNow --> internal : claim, grant badge
cron --> internal : due list, record misses

ring --> internal : getRing when\ngetRingVersion changes
short --> internal : (same snapshot:\nid, url, short code)
rollups --> internal : rank_score, likes\n(ADR 0004)
stats --> internal : isPublished,\nnet likes
short --> events : click
ring --> events : click + referral

note bottom of internal
  Only catalog writes the catalog database.
  Other services call its internal API over
  service bindings (not exposed by the gateway),
  which keeps each service independently deployable.
end note

note right of short
  Public on its own URL (RING_BASE_URL): widget
  links reach it directly, not through the gateway.
  Short codes are made by the catalog on publish.
  robots.txt keeps crawlers out of /ring/ and /r/.
end note

@enduml
