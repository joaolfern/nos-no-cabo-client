@startuml 14-seq-submit-moderation
!include ../../_style.iuml
title Submission and background SFW moderation (target)

participant "SPA" as spa
participant "gateway" as gw
participant "catalog" as catalog
participant "Turnstile" as ts
database "catalog D1" as db
queue "moderation-jobs" as q
participant "moderation" as mod
participant "Member site" as site
participant "Workers AI" as ai

spa -> gw : POST /v1/websites {submission}\n+ turnstile token
gw -> gw : rate limit (per IP hash)
gw -> catalog : create(submission)
catalog -> ts : siteverify(token)
ts --> catalog : ok
catalog -> catalog : validate, normalize url
catalog -> db : exists url_normalized?
alt duplicate
  catalog --> spa : 409 {error: duplicate, existingId}
else new
  catalog -> db : insert website (status = checking)
  catalog -> q : send {websiteId}
  note right: if the send fails, the site is\nflagged for manual review (model_error)
  catalog --> spa : 202 Website (checking)
end

== Background (seconds to minutes) ==
q -> mod : deliver {websiteId}
mod -> catalog : CatalogRpc.getForModeration(id)\n(service binding; not reachable via gateway)
alt no longer checking
  mod -> q : ack
else
  mod -> site : GET url (HTMLRewriter:\ntitle, meta, visible text excerpt)
  alt site unreachable
    mod -> catalog : applyModeration(hold, unreachable)
  else
    mod -> ai : llama-guard(name + description + excerpt)
    alt safe
      mod -> catalog : applyModeration(publish)
      catalog -> db : status = published, published_at, short_code
    else unsafe
      mod -> catalog : applyModeration(reject, unsafe)
    else error
      mod -> q : retry (backoff, max 3 attempts)\nthen applyModeration(hold, model_error)
    end
note over q, mod
  A job that throws on every attempt (e.g. catalog down)
  goes to moderation-jobs-dlq; its consumer (same Worker)
  calls applyModeration(hold, model_error), retrying
  every 5 min up to 10 times.
end note
  end
end
note right of catalog
  applyModeration writes moderation_results and the
  status in one D1 batch, only while status = checking,
  so retried messages are harmless. The moderation
  Worker has no D1 binding. Its code lives in a
  private repo (nos-sr submodule services/moderation).
end note

== Manual review ==
note over catalog, db
  Held sites (review_flag set) and reported sites are
  listed, approved or rejected with the review script
  (wrangler d1 execute) in the moderation repo.
end note

note over spa, gw
  The SPA never waits for moderation: it keeps a local
  draft and polls GET /v1/websites/status?ids=
  (see frontend/21-seq-submit-optimistic).
end note

@enduml
