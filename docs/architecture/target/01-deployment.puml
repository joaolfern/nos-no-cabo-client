@startuml 01-deployment
!include ../_style.iuml
title Deployment (target proposal: Cloudflare, free tier)

node "Browser" as browser {
  component "React SPA" as spa
  component "localStorage\npending drafts" as ls
}

cloud "Cloudflare" as cf {
  node "Pages" as pages {
    artifact "SPA build\n(nosnocabo.pages.dev)" as dist
  }
  node "Workers" as workers {
    component "gateway" as gw <<new>>
    component "catalog" as catalog <<new>>
    component "moderation\n(queue consumer)" as moderation <<new>>
    component "verification\n(+ Cron Trigger)" as verification <<new>>
    component "metrics" as metrics <<new>>
    component "router" as router <<new>>
  }
  database "D1\ncatalog DB" as d1catalog <<new>>
  database "D1\nmetrics DB" as d1metrics <<new>>
  database "KV\nshort codes, ring cache" as kv <<new>>
  queue "Queue\nmoderation-jobs" as q <<new>>
  component "Workers AI" as ai <<external>>
  component "Browser Rendering\n(optional screenshots)" as br <<external>>
  component "Turnstile" as ts <<external>>
}

browser --> pages : HTTPS
spa --> gw : /v1/*
spa ..> ls
gw --> catalog : service binding
gw --> verification : service binding
gw --> metrics : service binding
gw --> router : service binding
catalog --> d1catalog
catalog --> q : enqueue
q --> moderation
moderation --> ai
moderation ..> br
moderation --> catalog : set status\n(internal binding)
verification --> catalog : set verified_at\n(internal binding)
router --> kv
router --> catalog : ring order\n(cached in KV)
metrics --> d1metrics
catalog --> ts : siteverify

note bottom of cf
  <b>Free-tier budget</b> (checked 2026-09-30, re-check before launch)
  • Queues: 10,000 operations/day, 24 h retention
  • D1: 5 M rows read, 100 k rows written per day, 5 GB storage
  • Workers AI: 10,000 neurons/day (≈100 llama-guard text checks of ~2k tokens)
  • Browser Rendering: 10 browser-minutes/day, so screenshots are optional
  • Turnstile: free
  A spike beyond these limits degrades gracefully: jobs wait in the queue,
  and sites stay "checking" longer.
end note

@enduml
