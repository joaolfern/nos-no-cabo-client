@startuml 20-form-modules
!include ../../_style.iuml
skinparam linetype polyline
left to right direction
title nos-client — Submission, widget and terms features (as built)

package "src/pages/SubmitWebsite/  (route /websites/novo)" as submit {
  component "SubmitWebsite.tsx\nform → toast → /websites" as page <<new>>
  component "components/\nSubmitForm · Field · UrlField\nWebsitePreviewCard · CategoryPicker\nTurnstileField · DraftStatus" as submitComponents <<new>>
  component "hooks/\nuseWebsitePreview (query)\nuseSubmitWebsite (mutation)" as submitHooks <<new>>
  component "hooks/usePendingFeedItems\ndrafts → feed items (first)" as submitUtils <<new>>
  component "hooks/usePendingSubmissions\nlocalStorage 'nnc-pending-submissions'" as store <<new>>
  component "hooks/usePendingStatusPolling\nGET /v1/websites/status?ids=…\n15 s for 2 min, then on load/focus" as polling <<new>>
}

package "src/pages/WidgetEditor/  (route /websites/:id/selo)" as widget {
  component "WidgetEditor.tsx\npresets + options, live preview,\nterms consent, code" as editor <<new>>
  component "utils/buildWidgetSnippet\n(scoped HTML, data-nnc-widget=id,\nring links from RING_BASE_URL)" as snippet <<new>>
  component "VerificationStatus + UnverifiedModal\n(✓ or ? badge, used by Feed and Website)" as status <<new>>
  component "VerifyPanel\nPOST /v1/websites/:id/verify\n(used by Website)" as verify <<new>>
}

package "src/pages/Terms/  (route /termos)" as terms {
  component "TermsContent · TermsModal\nuseTermsAcceptance (versioned)" as termsContent <<new>>
}

package "src/pages/Feed/" as feed {
  component "Feed list\n(default 'Melhores' = server order)" as feedList
  component "FeedCardList / FeedCard / FeedTable\n+ pending prop (first items)\n+ tone 'draft' | 'rejected'" as card
}

package "src/pages/Website/" as website {
  component "WebsiteInfoCard" as infoCard
}

package "global" {
  component "@/components: PageTrail, Modal,\nButton, Input, Textarea, LoadingDots" as ui
  component "@/hooks/useLocalStorageJson" as lsJson <<new>>
  component "@/utils/normalizeUrl" as normalize <<new>>
  component "@/api/api.ts" as api
  component "SiteFooter (layout)\nTermos de uso · Contato" as siteFooter <<new>>
}

page --> submitComponents
page --> submitHooks
submitHooks --> api
submitHooks --> store : add draft on 202
submitComponents --> ui
submitComponents --> normalize

store --> lsJson
polling --> store : update / drop
polling --> api
feedList -[#C62828]-> submitUtils : pending items
submitUtils --> polling
submitUtils --> store
feedList --> card
card -[#C62828]-> status
infoCard -[#C62828]-> status
infoCard -[#C62828]-> verify
status --> editor : "Sou responsável"
verify --> api
editor --> snippet
editor -[#C62828]-> termsContent : consent + modal
termsContent --> lsJson
siteFooter --> termsContent : /termos

note top of feed
  Cross-feature imports (red) are deliberate:
  SubmitWebsite owns drafts, WidgetEditor owns
  verification, Terms owns the terms text.
end note

note bottom of feed
  Removed (phase 6): src/pages/WebsiteForm/ (modal wizard,
  6 steps, context, floating button), FloatingButtons,
  usePreregisterWebsite/useRegisterWebsite and the legacy
  POST/PATCH /website mocks.
end note

@enduml
