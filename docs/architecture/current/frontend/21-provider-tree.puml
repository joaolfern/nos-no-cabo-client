@startuml 21-provider-tree
!include ../../_style.iuml
title nos-client — Provider tree (current state)

rectangle "main.tsx\n(start MSW worker if ENABLE_MOCKS, then render)" as main
rectangle "RouterProvider (BrowserRouter)" as router
rectangle "ThemeProvider\nCSS vars on :root · localStorage · prefers-color-scheme" as theme
rectangle "MessageProvider\ntoast queue (Portal)" as message
rectangle "ErrorBoundary" as boundary
rectangle "QueryProvider\nTanStack QueryClient" as query
rectangle "IconProvider" as icon
rectangle "NosNoCaboProviders\n(pages/Webring)" as nnc <<issue>>
rectangle "SortProvider\nuseState, default date_desc" as sort
rectangle "FiltersProvider\n?categoria (URL) + search (useState)" as filters
rectangle "WebsitesProvider\nGET /websites · filter by keyword · sort" as websites
rectangle "Router (routes.tsx)" as routesNode
rectangle "WebsiteFormProvider\nmodal open/close" as formProv
rectangle "<Routes/>" as routesEl
rectangle "<WebsiteFormModal/>" as modal

main --> router
router --> theme
theme --> message
message --> boundary
boundary --> query
query --> icon
icon --> nnc
nnc --> sort
sort --> filters
filters --> websites
websites --> routesNode
routesNode --> formProv
formProv --> routesEl
formProv --> modal

note right of nnc
  Feed-only state (sort, filters, the whole website list)
  is mounted above every route, so Landing and NotFound
  also fetch /websites and /keywords.
end note

note right of websites
  Search filtering is not done here: Feed.tsx
  applies it afterwards, so the filtering logic
  is split across two places.
end note

note right of routesEl
  /website/:id wraps its own WebsiteDetailsProvider
  (see 26-seq-website-details).
end note

@enduml
