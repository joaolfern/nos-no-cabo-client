@startuml 23-data-layer
!include ../../_style.iuml
skinparam linetype polyline
title nos-client — Data layer (current state)

package "hooks/useDataHooks.ts" {
  component "useWebsitesData\nkey ['websites']" as qWebsites
  component "useWebsiteDetailsData(id)\nkey [{type:'websiteDetails', id}]" as qDetails <<issue>>
  component "useKeywordsData\nkey ['keywords']" as qKeywords
  component "useRecommendedBooks(subject)\nkey ['recommendedBooks', s]" as qBooks
  component "usePreregisterWebsite\n(mutation)" as mPre
  component "useRegisterWebsite\n(mutation, optimistic)" as mReg <<issue>>
  component "useReportWebsite\n(mutation, optimistic)" as mReport
  component "useAuthorData · useKeywordData" as qDead <<dead>>
}

component "api (axios)\nbase API_URL\n+ x-admin-password if admin mode\nerror → reject(data) with message = data.error" as api
component "openLibraryApi (axios)" as olApi

package "nos-sr" {
  rectangle "GET /websites" as eWebsites
  rectangle "GET /website/:id" as eDetail
  rectangle "GET /keywords" as eKeywords
  rectangle "POST /website" as ePost
  rectangle "PATCH /website (stub)" as ePatch <<issue>>
  rectangle "DELETE /website/:id (admin)" as eDelete
  rectangle "GET /authors/:id · /keywords/:id\n(do not exist)" as eMissing <<issue>>
}
rectangle "openlibrary.org\nsubjects/{s}.json?limit=3" as openlib <<external>>

package "Client-side mocked domains (no backend)" {
  component "mockWebsiteMetrics\nseeded likes + visits\n(Feed likes_desc sort, FeedCard, FeedTable, WebsiteMetrics)" as metrics <<mocked>>
  component "WebsiteVotes\nlocal useState only" as votes <<mocked>>
  component "LandingPage/mocks.ts\npicsum bubbles" as bubbles <<mocked>>
}

package "~__mocks~__ (MSW, ON by default)" as msw <<mocked>> {
  component "handlers.ts: /websites, /keywords,\nPOST/PATCH /website, DELETE /website/:id,\nGET /website/:id" as handlers
  component "data/parseRegisterDataToWebsite\n(imported by production code)" as parseHelper <<issue>>
}

qWebsites --> api
qDetails --> api
qKeywords --> api
mPre --> api
mReg --> api
mReport --> api
qDead --> api
qBooks --> olApi

api --> eWebsites
api --> eDetail
api --> eKeywords
api --> ePost
api --> ePatch
api --> eDelete
api --> eMissing
olApi --> openlib

mReg --> parseHelper
handlers ..> api : intercepts in browser\nand in Jest (node)

note bottom of qDetails
  Typed IWebsite[] with a [] fallback, but the
  endpoint returns one object; the result is
  spread into an object by WebsiteDetailsProvider.
end note

note bottom of mReg
  Sends keywords as names; the optimistic helper
  builds keywords with temp-id-N ids, which leaves
  duplicate keywords in the ['keywords'] cache.
  The PATCH persists nothing, so the optimistic
  row disappears on refetch.
end note

note right of mReport
  "Report" = DELETE with the admin header.
  Without admin mode it fails, and the
  optimistic removal is rolled back.
end note

@enduml
