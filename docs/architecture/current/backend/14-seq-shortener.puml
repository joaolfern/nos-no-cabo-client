@startuml 14-seq-shortener
!include ../../_style.iuml
title URL shortener and click tracking (current state)

actor "Visitor" as visitor
participant "shorteners_bp" as route
participant "URLShortenerService" as svc
database "Postgres" as db
participant "Member site" as site

== Create (POST /shorten), no auth ==
visitor -> route : POST /shorten {url}
route -> svc : create_mapping(url)
svc -> db : insert url_mappings (short_url = "")
svc -> db : flush → id
svc -> svc : short_url = base62(id)
svc -> db : commit
route --> visitor : {short_url, original_url, created_at}

== Redirect (GET /nos/:code) ==
visitor -> route : GET /nos/b
route -> svc : get_mapping("b")
svc -> db : get url_mappings by decode_base62("b")
alt found
  route -> svc : track_access("b")
  svc -> db : upsert url_analytics\n(click_count+1, last_accessed)
  route --> visitor : 302 Location: original_url
  visitor -> site : follow redirect
else not found
  route --> visitor : 404 {error}
end

note over route, db
  The analytics are the only real "metric" the backend has.
  The client does not read them yet: likes and visits in the UI are mocked.
end note

@enduml
