@startuml 12-api-contract
!include ../../_style.iuml
hide circle
hide empty members
title nos-sr — HTTP API contract (current state)

package "websites_bp" {
  class "GET /websites" as getWebsites {
    {field} → WebsiteSchema[] (all rows, no paging)
  }
  class "GET /website/:website_id (string)" as getWebsite {
    {field} → WebsiteSchema
    {field} 404 {error}
  }
  class "POST /website" as postWebsite {
    {field} body {url} (must start with http)
    {field} → PreWebsiteResponseSchema
    {field} 400 {error} fetch fail / duplicate / no webring link
    {field} 400 {message} invalid url (abort in validator)
    {field} 500 {error: "Database Crash: …"}
  }
  class "PATCH /website" as patchWebsite <<issue>> {
    {field} body PreWebsiteUpdateBodySchema
    {field} → {message} ALWAYS; persists nothing
    {field} no auth
  }
  class "DELETE /website/:website_id (int)" as deleteWebsite <<issue>> {
    {field} header x-admin-password
    {field} → {message}
    {field} 404 {error}
    {field} wrong password → abort(403) is caught by the
    {field} generic except → 500 {error}
  }
}

package "keywords_bp" {
  class "GET /keywords/" as getKeywords {
    {field} → KeywordSchema[]
  }
}

package "shorteners_bp (no auth)" {
  class "POST /shorten" as shorten {
    {field} body {url}
    {field} → URLMappingSchema
  }
  class "GET /nos/:short_url" as redirect {
    {field} 302 → original_url (+1 click)
    {field} 404 {error}
  }
  class "GET /shorteners" as listShort {
    {field} → URLMappingSchema[]
  }
  class "GET /shorteners/analytics" as listAnalytics {
    {field} → URLAnalyticsSchema[]
  }
}

package "schemas" {
  class WebsiteSchema {
    {field} id : int
    {field} name : str
    {field} description : str
    {field} url : str  (short code after approve)
    {field} color : str
    {field} createdAt : str
    {field} updatedAt : str
    {field} faviconUrl : str
    {field} keywords : KeywordSchema[]
    {field} repo : str?
  }
  class KeywordSchema {
    {field} id : int
    {field} name : str
    {field} createdAt : str
  }
  class PreWebsiteResponseSchema {
    {field} url, id?, name?, description?,
    {field} color?, createdAt?, faviconUrl?, repo?
  }
  class PreWebsiteUpdateBodySchema {
    {field} …PreWebsiteResponseSchema
    {field} keywords : str[]  (names)
  }
  class URLMappingSchema {
    {field} short_url, original_url, created_at
  }
  class URLAnalyticsSchema {
    {field} short_url, click_count, last_accessed
  }
  class "Error shapes" as errors <<issue>> {
    {field} {error}  most handlers
    {field} {message}  ErrorSchema (OpenAPI docs), 403, validators
    {field} 422 {error}  Pydantic validation
  }
}

getWebsites ..> WebsiteSchema
getWebsite ..> WebsiteSchema
postWebsite ..> PreWebsiteResponseSchema
patchWebsite ..> PreWebsiteUpdateBodySchema
WebsiteSchema *-- KeywordSchema
getKeywords ..> KeywordSchema
shorten ..> URLMappingSchema
listShort ..> URLMappingSchema
listAnalytics ..> URLAnalyticsSchema

note as conventions
  <b>Conventions</b>
  • No versioning, no pagination, filtering or sorting
  • Singular vs plural paths mixed (/website vs /websites)
  • website_id: str in the schema, int in the DELETE route
  • Messages are mostly pt-BR, some in English
  • OpenAPI docs are served at /openapi
end note

@enduml
