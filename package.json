{
  "name": "jlf-nosnocabo-client",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "oxlint --fix --deny-warnings --report-unused-disable-directives src",
    "format": "prettier --write src/",
    "prepare": "husky",
    "test": "vitest run",
    "docs:diagrams": "bash docs/architecture/export-diagrams.sh",
    "docs:site:assets": "bash docs/site/build-assets.sh",
    "docs:site:dev": "vite --config docs/site/vite.config.ts",
    "docs:site:build": "pnpm run docs:site:assets && tsc -p docs/site && vite build --config docs/site/vite.config.ts",
    "deploy:docs": "pnpm run docs:site:build && wrangler deploy -c wrangler.docs.jsonc",
    "deploy:web": "pnpm run snapshot:ring && pnpm build && wrangler deploy",
    "snapshot:ring": "node --env-file=.env.production scripts/snapshotRing.mjs",
    "pwa:icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@nosnocabo/contract": "^0.4.0",
    "@react-spring/web": "^10.0.3",
    "@tanstack/react-query": "^5.85.5",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router": "^7.11.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^16.1.5",
    "msw": "^2.15.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.91.0",
    "typescript": "^7.0.2",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.146.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix --deny-warnings",
      "prettier --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
