{
  "name": "jlf-nosnocabo-client",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite build && vite preview",
    "build": "tsc -b && vite build",
    "lint": "oxlint --fix --deny-warnings --report-unused-disable-directives src",
    "format": "prettier --write src/",
    "prepare": "husky",
    "test": "vitest run",
    "docs:diagrams": "bash docs/architecture/export-diagrams.sh"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@nosnocabo/contract": "^0.3.0",
    "@react-spring/web": "^10.0.3",
    "@tanstack/react-query": "^5.85.5",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router": "^7.11.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^16.1.5",
    "msw": "^2.15.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.91.0",
    "typescript": "^7.0.2",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^6.3.5",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix --deny-warnings",
      "prettier --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
