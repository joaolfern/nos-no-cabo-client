VITE_DEV_API_URL=http://localhost:3000
VITE_ENV=production
VITE_ENABLE_MOCKS=false
# The /v1 API (Cloudflare Workers). Defaults to ${VITE_DEV_API_URL}/v1.
# Staging: https://nnc-gateway-staging.joaolfern.workers.dev/v1
VITE_V1_API_URL=
# Where widget links point. Ring and short links (/ring/…, /r/…) go to the router Worker.
# Staging: https://nnc-router-staging.joaolfern.workers.dev and https://nosnocabo.joaolfern.workers.dev
# These end up in members' HTML: set them to the custom domain before anyone installs a widget.
VITE_RING_BASE_URL=
VITE_NOS_NO_CABO_URL=
VITE_TURNSTILE_SITE_KEY=
VITE_GITHUB_URL=
VITE_TWITTER_URL=
VITE_CONTACT_EMAIL=
