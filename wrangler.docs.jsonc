{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The architecture docs site (docs/site), served as static assets at docs.nosnocabo.com.br.
  "name": "nosnocabo-docs",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "docs.nosnocabo.com.br", "custom_domain": true }],
  "assets": {
    "directory": "./out/docs-site",
  },
}
